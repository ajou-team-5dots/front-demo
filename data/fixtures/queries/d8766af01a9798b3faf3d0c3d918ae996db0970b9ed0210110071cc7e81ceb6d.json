{"sql":"WITH abilities AS ( SELECT boss_id, ability FROM ability_events WHERE ability != '' GROUP BY boss_id, ability ), entity_abilities AS ( SELECT boss_id, entity_id, groupArray((ability, ts)) AS events FROM ability_events WHERE ability != '' GROUP BY boss_id, entity_id ), subjects AS ( SELECT monster_id, entity_id, ts AS reference_ts, true AS is_death FROM player_deaths WHERE ({allPeriod:UInt8} = 1 OR NOT pre_patch_entity) AND ({heavy:String} = 'include' OR NOT heavy_account) UNION ALL SELECT monster_id, entity_id, max_hit_ts AS reference_ts, false AS is_death FROM encounters WHERE n_taken > 0 AND NOT died AND ({allPeriod:UInt8} = 1 OR NOT pre_patch_entity) AND ({heavy:String} = 'include' OR NOT heavy_account) ) SELECT a.boss_id AS monster, a.ability AS abilityId, w.seconds AS window, toUInt32(countIf(s.is_death)) AS deathsTotal, toUInt32(countIf(NOT s.is_death)) AS survEncTotal, toUInt32(countIf(s.is_death AND arrayExists( ev -> ev.1 = a.ability AND ev.2 >= s.reference_ts - w.seconds * 1000 AND ev.2 <= s.reference_ts, e.events))) AS deathsWithAbility, toUInt32(countIf(NOT s.is_death AND arrayExists( ev -> ev.1 = a.ability AND ev.2 >= s.reference_ts - w.seconds * 1000 AND ev.2 <= s.reference_ts, e.events))) AS survEncWithAbility FROM abilities AS a INNER JOIN subjects AS s ON s.monster_id = a.boss_id LEFT JOIN entity_abilities AS e ON e.boss_id = s.monster_id AND e.entity_id = s.entity_id CROSS JOIN (SELECT arrayJoin({windows:Array(UInt32)}) AS seconds) AS w GROUP BY a.boss_id, a.ability, w.seconds ORDER BY monster, abilityId, window DESC","params":{"heavy":"include","allPeriod":0,"windows":[5,2]},"rows":[{"monster":"cindermaw_stage_1","abilityId":"cindermaw_bolt","window":5,"deathsTotal":1,"survEncTotal":4,"deathsWithAbility":1,"survEncWithAbility":1},{"monster":"cindermaw_stage_1","abilityId":"cindermaw_bolt","window":2,"deathsTotal":1,"survEncTotal":4,"deathsWithAbility":1,"survEncWithAbility":1},{"monster":"cindermaw_stage_1","abilityId":"cindermaw_stage_1_b