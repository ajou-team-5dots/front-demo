{"sql":"WITH base AS ( SELECT monster_id, role, stage, player_seq, died, near20, toUInt8(start_ts >= {patchTs:Int64}) AS after_patch, toString(toDate(fromUnixTimestamp64Milli(start_ts), 'Asia/Seoul')) AS day FROM encounters WHERE start_ts >= {from:Int64} AND start_ts < {to:Int64} AND ({heavy:String} = 'include' OR NOT heavy_account) ), stage_counts AS ( SELECT monster_id, stage, count() AS n FROM base GROUP BY monster_id, stage ), stages AS ( SELECT monster_id, groupArray((stage, toUInt32(n))) AS counts FROM stage_counts GROUP BY monster_id ), day_counts AS ( SELECT monster_id, after_patch, day, toUInt32(count()) AS enc, toUInt32(countIf(died)) AS deaths, toUInt32(countIf(near20)) AS near, toUInt32(uniqExact(player_seq)) AS players FROM base GROUP BY monster_id, after_patch, day ), days AS ( SELECT monster_id, after_patch, groupArray((day, enc, deaths, near, players)) AS counts FROM day_counts GROUP BY monster_id, after_patch ), periods AS ( SELECT monster_id, any(role) AS role, after_patch, toUInt32(count()) AS enc, toUInt32(countIf(died)) AS deaths, toUInt32(countIf(near20)) AS near, toUInt32(uniqExact(player_seq)) AS players FROM base GROUP BY monster_id, after_patch ) SELECT p.monster_id AS monster, p.role AS role, p.after_patch AS afterPatch, p.enc AS enc, p.deaths AS deaths, p.near AS near, p.deaths + p.near AS events, (p.deaths + p.near) / p.enc * 100 AS risk100, p.players AS players, s.counts AS stages, d.counts AS days FROM periods AS p LEFT JOIN stages AS s ON s.monster_id = p.monster_id LEFT JOIN days AS d ON d.monster_id = p.monster_id AND d.after_patch = p.after_patch ORDER BY monster, afterPatch","params":{"heavy":"include","from":-9007199254740991,"patchTs":1791956400000,"to":9007199254740991},"rows":[{"monster":"abyss_beast_medium","role":"midboss","afterPatch":0,"enc":4,"deaths":0,"near":0,"events":0,"risk100":0,"players":2,"stages":[[0,3],[4,93],[3,85]],"days":[["2026-10-14",4,0,0,2]]},{"monster":"abyss_beast_medium","role":"midboss","afterPatch":1