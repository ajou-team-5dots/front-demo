{"sql":"WITH scoped_enc AS ( SELECT monster_id, role, grade, stage, danger, n_taken, max_hit_taken, p_max_hp FROM encounters WHERE ({allPeriod:UInt8} = 1 OR NOT pre_patch_entity) AND ({heavy:String} = 'include' OR NOT heavy_account) ), scoped_deaths AS ( SELECT monster_id, stage, answered FROM player_deaths WHERE ({allPeriod:UInt8} = 1 OR NOT pre_patch_entity) AND ({heavy:String} = 'include' OR NOT heavy_account) ), enc_stages AS ( SELECT monster_id, role, grade, stage, count() AS enc FROM scoped_enc GROUP BY monster_id, role, grade, stage ), death_stages AS ( SELECT monster_id, stage, count() AS deaths FROM scoped_deaths GROUP BY monster_id, stage ), rates AS ( SELECT e.role AS role, e.grade AS grade, e.stage AS stage, sum(d.deaths) / sum(e.enc) AS rate FROM enc_stages AS e LEFT JOIN death_stages AS d ON d.monster_id = e.monster_id AND d.stage = e.stage GROUP BY e.role, e.grade, e.stage ), expected AS ( SELECT e.monster_id AS monster_id, sum(e.enc * r.rate) AS expDeathsStage, argMax(e.stage, (e.enc, -e.stage)) AS mainStage FROM enc_stages AS e INNER JOIN rates AS r ON r.role = e.role AND r.grade = e.grade AND r.stage = e.stage GROUP BY e.monster_id ), enc_counts AS ( SELECT monster_id, any(role) AS role, any(grade) AS grade, toUInt32(count()) AS enc, toUInt32(countIf(danger)) AS danger, toUInt32(countIf(n_taken > 0)) AS hitEnc, toUInt32(countIf(n_taken > 0 AND p_max_hp > 0 AND max_hit_taken / p_max_hp >= {bigHit:Float64})) AS bigHit FROM scoped_enc GROUP BY monster_id ), death_counts AS ( SELECT monster_id, toUInt32(count()) AS deaths, toUInt32(countIf(NOT answered)) AS unanswered FROM scoped_deaths GROUP BY monster_id ), summary AS ( SELECT e.monster_id AS monster, e.role AS role, e.grade AS grade, x.mainStage AS mainStage, e.enc AS enc, d.deaths AS deaths, e.danger AS danger, d.deaths / e.enc * 100 AS deathsPer100, e.hitEnc AS hitEnc, e.bigHit AS bigHit, d.unanswered AS unanswered, if(x.expDeathsStage = 0, if(d.deaths > 0, 1., 0.), arraySum(arrayMap(k -> exp(k * log(greatest(x.expDeathsStage, 1e-300)) - x.expDeathsStage - lgamma(k + 1)), range(d.deaths)))) AS cdfBelow FROM enc_counts AS e LEFT JOIN death_counts AS d ON d.monster_id = e.monster_id INNER JOIN expected AS x ON x.monster_id = e.monster_id ) SELECT monster, role, grade, mainStage, enc, deaths, danger, deathsPer100, hitEnc, bigHit, unanswered, multiIf(cdfBelow >= {strongQuantile:Float64}, 'strong', cdfBelow >= {signalQuantile:Float64}, 'signal', 'none') AS signal FROM summary ORDER BY monster","params":{"heavy":"exclude","allPeriod":1,"bigHit":0.5,"strongQuantile":0.998,"signalQuantile":0.95},"rows":[{"monster":"abyss_beast_medium","role":"midboss","grade":"medium","mainStage":3,"enc":143,"deaths":4,"danger":2,"deathsPer100":2.797202797202797,"hitEnc":110,"bigHit":3,"unanswered":0,"signal":"none"},{"monster":"abyss_beast_weak","role":"midboss","grade":"weak","mainStage":2,"enc":87,"deaths":0,"danger":0,"deathsPer100":0,"hitEnc":60,"bigHit":0,"unanswered":0,"signal":"none"},{"monster":"abyss_colossus","role":"midboss","grade":"boss","mainStage":0,"enc":12,"deaths":2,"danger":4,"deathsPer100":16.666666666666664,"hitEnc":7,"bigHit":4,"unanswered":0,"signal":"none"},{"monster":"blink_imp","role":"mob","grade":"none","mainStage":3,"enc":6830,"deaths":26,"danger":36,"deathsPer100":0.3806734992679356,"hitEnc":2459,"bigHit":0,"unanswered":14,"signal":"none"},{"monster":"cindermaw_stage_1","role":"boss","grade":"boss","mainStage":0,"enc":4,"deaths":1,"danger":0,"deathsPer100":25,"hitEnc":4,"bigHit":0,"unanswered":1,"signal":"none"},{"monster":"cragheart_stage_1","role":"boss","grade":"boss","mainStage":2,"enc":47,"deaths":4,"danger":7,"deathsPer100":8.51063829787234,"hitEnc":46,"bigHit":5,"unanswered":0,"signal":"none"},{"monster":"cragheart_stage_2","role":"boss","grade":"boss","mainStage":3,"enc":3,"deaths":0,"danger":1,"deathsPer100":0,"hitEnc":3,"bigHit":0,"unanswered":0,"signal":"none"},{"monster":"cragheart_stage_3","role":"boss","grade":"boss","mainStage":4,"enc":2