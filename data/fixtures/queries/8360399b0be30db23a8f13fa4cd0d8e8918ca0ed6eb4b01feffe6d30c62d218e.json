{"sql":"SELECT multiIf(level IS NULL, '모름', level < 20, '1~19', level < 40, '20~39', level < 70, '40~69', '70+') AS lv, multiIf(weapon_tier IN ('none', 'wooden'), '없음·나무', weapon_tier = 'stone', '돌', weapon_tier = 'iron', '철', '금·다이아') AS wp, multiIf(armor_count = 0, '없음', armor_count < 6, '일부', '6부위') AS ar, multiIf(role = 'boss', '던전 보스', role = 'midboss', '중간보스', grade = 'strong', '일반·strong', grade = 'medium', '일반·medium', '일반·약함') AS grp, toUInt32(count()) AS n FROM ( SELECT d.level AS level, d.weapon_tier AS weapon_tier, d.armor_count AS armor_count, c.role AS role, c.grade AS grade FROM player_deaths AS d LEFT JOIN (SELECT monster_id, any(role) AS role, any(grade) AS grade FROM encounters GROUP BY monster_id) AS c ON c.monster_id = d.monster_id WHERE d.monster_id != '' AND ({allPeriod:UInt8} = 1 OR NOT pre_patch_entity) AND ({heavy:String} = 'include' OR NOT heavy_account) ) GROUP BY lv, wp, ar, grp","params":{"heavy":"exclude","allPeriod":0},"rows":[{"lv":"20~39","wp":"철","ar":"6부위","grp":"중간보스","n":5},{"lv":"20~39","wp":"철","ar":"6부위","grp":"일반·medium","n":7},{"lv":"1~19","wp":"철","ar":"6부위","grp":"일반·strong","n":1},{"lv":"40~69","wp":"금·다이아","ar":"6부위","grp":"일반·strong","n":5},{"lv":"20~39","wp":"없음·나무","ar":"6부위","grp":"일반·약함","n":6},{"lv":"1~19","wp":"돌","ar":"6부위","grp":"던전 보스","n":10},{"lv":"40~69","wp":"철","ar":"6부위","grp":"일반·strong","n":5},{"lv":"20~39","wp":"돌","ar":"6부위","grp":"일반·medium","n":1},{"lv":"1~19","wp":"돌","ar":"없음","grp":"일반·약함","n":4},{"lv":"1~19","wp":"없음·나무","ar":"없음","grp":"던전 보스","n":1},{"lv":"20~39","wp":"철","ar":"일부","grp":"던전 보스","n":1},{"lv":"40~69","wp":"철","ar":"6부위","grp":"던전 보스","n":2},{"lv":"20~39","wp":"없음·나무","ar":"6부위","grp":"일반·strong","n":4},{"lv":"1~19","wp":"없음·나무","ar":"없음","grp":"일반·약함","n":106},{"lv":"1~19","wp":"철","ar":"일부","grp":"던전 보스","n":1},{"lv":"40~69","wp":"없음·나무","ar":"일부","grp":"일반·strong","n":3},{"lv":"40~69","wp":"돌","ar":"일부","grp":"일반·strong","n":1},{"lv":"1~19","wp":"돌","ar":"6부위","grp":"일반·mediu