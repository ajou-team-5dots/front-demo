{
  "$description": "5dots 몬스터 밸런스 보드 디자인 토큰. 단일 원본. 고친 뒤 pnpm tokens 로 src/styles/tokens.css, src/styles/tokens.ts 를 다시 만든다. 형식: W3C Design Tokens (DTCG). 섞은 색은 $extensions.org.5dots.mix (CSS color-mix, oklab) 로 적는다.",
  "color": {
    "$type": "color",
    "base": {
      "brand": {
        "$value": "#a97b1e",
        "$description": "브랜드(AKKADIA 로고). 디자이너 원안 #c3ab6a 를 대비 때문에 진하게"
      },
      "ink": { "$value": "#0b1220", "$description": "모든 본문 글자" },
      "gray-1": { "$value": "#4f5b6e", "$description": "보조 글자, 축 눈금" },
      "gray-2": { "$value": "#bfc8d6", "$description": "컨트롤 테두리, 0 기준선" },
      "gray-3": { "$value": "#e9eef5", "$description": "페이지 바탕, 세그먼트 바탕, 칩" },
      "panel": { "$value": "#ffffff", "$description": "패널 바탕" },
      "primary-strong": { "$value": "#a8904f", "$description": "shadcn primary 진한 쪽" },
      "primary-soft": { "$value": "#f4efe1", "$description": "shadcn primary 옅은 쪽" },
      "success-soft": { "$value": "#e6f0f1", "$description": "shadcn success 옅은 쪽" },
      "skeleton-shine": { "$value": "#f8fafc", "$description": "로딩 뼈대가 반짝이는 가운데 색" }
    },
    "chart": {
      "actual": { "$value": "#22448f", "$description": "고른 몬스터 자신의 값" },
      "comparison": { "$value": "#2f6fe0", "$description": "비교 집단, 평균, 중앙값" },
      "death": { "$value": "#d64a5f", "$description": "사망 쪽" },
      "survival": { "$value": "#0f9a8f", "$description": "생존, 처치 쪽" },
      "track": { "$value": "#e7ecf3", "$description": "막대의 빈 부분, 비교 범위, 격자" },
      "accent": {
        "$value": "#c0850f",
        "$description": "추가 범주 색 (흐름도). 흰 바탕 3:1 미만이라 칸마다 글자를 붙인다"
      },
      "earth": { "$value": "#9b5f2e", "$description": "추가 범주 색 (흐름도)" },
      "violet": { "$value": "#b04fc0", "$description": "추가 범주 색 (흐름도)" },
      "neutral": {
        "$value": "{color.base.gray-2}",
        "$description": "조용한 중립. gray-2 를 gray-1 쪽으로 30% (#9ca6b6, 흰 바탕 2.46:1). 점 모양으로만 쓰고 글자에는 쓰지 않는다",
        "$extensions": { "org.5dots.mix": { "with": "{color.base.gray-1}", "amount": 0.7 } }
      }
    },
    "status": {
      "warning": { "$value": "#985a00", "$description": "점검 필요" },
      "danger": { "$value": "#c2334f", "$description": "강한 신호, 오류" },
      "supported": { "$value": "#1e4f9a", "$description": "가설 지지" },
      "warning-soft": {
        "$value": "{color.status.warning}",
        "$description": "배지 바탕: 상태색 10% + 패널",
        "$extensions": { "org.5dots.mix": { "with": "{color.base.panel}", "amount": 0.1 } }
      },
      "danger-soft": {
        "$value": "{color.status.danger}",
        "$description": "배지 바탕: 상태색 10% + 패널",
        "$extensions": { "org.5dots.mix": { "with": "{color.base.panel}", "amount": 0.1 } }
      },
      "supported-soft": {
        "$value": "{color.status.supported}",
        "$description": "배지 바탕: 상태색 10% + 패널",
        "$extensions": { "org.5dots.mix": { "with": "{color.base.panel}", "amount": 0.1 } }
      }
    },
    "sankey": {
      "$description": "흐름도 칸 색. 칸(열)마다 값 순서대로 1, 2, 3 … 칸 안에서 서로 다른 색이어야 한다 (색약 구분 검사 통과 조합)",
      "lv": {
        "1": { "$value": "{color.chart.accent}" },
        "2": { "$value": "{color.chart.survival}" },
        "3": { "$value": "{color.chart.comparison}" },
        "4": { "$value": "{color.chart.earth}" }
      },
      "wp": {
        "1": { "$value": "{color.chart.survival}" },
        "2": { "$value": "{color.chart.earth}" },
        "3": { "$value": "{color.chart.comparison}" },
        "4": { "$value": "{color.chart.accent}" }
      },
      "ar": {
        "1": { "$value": "{color.chart.accent}" },
        "2": { "$value": "{color.chart.comparison}" },
        "3": { "$value": "{color.chart.survival}" }
      },
      "grp": {
        "1": { "$value": "{color.chart.comparison}" },
        "2": { "$value": "{color.chart.survival}" },
        "3": { "$value": "{color.chart.accent}" },
        "4": { "$value": "{color.chart.violet}" },
        "5": { "$value": "{color.chart.earth}" }
      },
      "neutral": {
        "$value": "{color.chart.neutral}",
        "$description": "정해진 순서 밖의 값 (예: 모르는 레벨)"
      }
    },
    "scatter": {
      "high": { "$value": "{color.chart.death}", "$description": "기대 대비 2배 이상" },
      "mid": { "$value": "{color.chart.comparison}", "$description": "1~2배" },
      "below": { "$value": "{color.chart.neutral}", "$description": "1배 미만" },
      "zone": {
        "$value": "{color.chart.death}",
        "$description": "우선 점검 구역 바탕: 사망색 8% + 패널",
        "$extensions": { "org.5dots.mix": { "with": "{color.base.panel}", "amount": 0.08 } }
      }
    },
    "text-scale": {
      "$description": "작은 글자용으로 대비를 올린 글자색",
      "flag": {
        "$value": "{color.chart.death}",
        "$description": "위험 2배 이상 숫자 (13px). 사망색(흰 바탕 4.20:1)을 ink 쪽으로 15%: 흰 바탕 5.42:1, gray-3 위 4.65:1",
        "$extensions": { "org.5dots.mix": { "with": "{color.base.ink}", "amount": 0.85 } }
      },
      "sub": {
        "$value": "{color.base.gray-1}",
        "$description": "목록 보조 글자. gray-1 을 ink 쪽으로 5%: 흰 바탕 7.32:1, gray-3 위 6.28:1",
        "$extensions": { "org.5dots.mix": { "with": "{color.base.ink}", "amount": 0.95 } }
      }
    },
    "state": {
      "row-hover": {
        "$value": "{color.base.gray-3}",
        "$description": "목록 행: 다른 차트에서 가리킬 때 바탕 (gray-3 60%)",
        "$extensions": { "org.5dots.mix": { "with": "transparent", "amount": 0.6 } }
      },
      "chip-hover": {
        "$value": "{color.base.gray-2}",
        "$description": "흐름 칩 hover 바탕 (gray-2 50%)",
        "$extensions": { "org.5dots.mix": { "with": "transparent", "amount": 0.5 } }
      }
    }
  },
  "opacity": {
    "$type": "number",
    "band": {
      "$description": "흐름도 띠",
      "default": { "$value": 0.35, "$description": "아무것도 고르지 않았을 때" },
      "hover": { "$value": 0.75, "$description": "가리킨 레벨 갈래" },
      "picked": { "$value": 0.85, "$description": "고른 칸을 지나는 띠" },
      "dim": { "$value": 0.08, "$description": "물러난 띠" }
    },
    "dim": {
      "node": { "$value": 0.35, "$description": "흐름도: 맞는 흐름이 없는 칸" },
      "mark": { "$value": 0.4, "$description": "산점도: 다른 점을 가리킬 때 나머지 점" },
      "label": { "$value": 0.45, "$description": "오각형: 다른 축을 가리킬 때 나머지 축 이름" },
      "line": { "$value": 0.35, "$description": "패치 추이: 교전이 적은 날이 섞인 선 전체" }
    },
    "line": {
      "grid": { "$value": 0.7, "$description": "격자선 (패치 추이 가로선, 오각형 바큇살)" },
      "ring": { "$value": 0.8, "$description": "오각형 눈금 고리" },
      "reference": { "$value": 0.7, "$description": "산점도 기대 = 1배 점선" },
      "flag": { "$value": 0.55, "$description": "산점도 2배 선" },
      "median": { "$value": 0.6, "$description": "산점도 사망 수 중앙값 점선" }
    },
    "fill": {
      "area": { "$value": 0.18, "$description": "오각형 안쪽 면" }
    },
    "point": {
      "thin": { "$value": 0.6, "$description": "패치 추이: 교전이 적은 날 빈 점 테두리" }
    },
    "pending": { "$value": 0.6, "$description": "필터를 바꾸는 동안 내용 흐림" }
  },
  "radius": {
    "$type": "dimension",
    "panel": { "$value": "10px", "$description": "패널, KPI 상자" },
    "control": { "$value": "6px", "$description": "선택 상자, 칩, 목록 행, 툴팁" },
    "pill": { "$value": "4px", "$description": "배지, 세그먼트 단추, 막대" },
    "focus": { "$value": "4px", "$description": "흐름도 칸 키보드 초점 고리" },
    "mark": { "$value": "2px", "$description": "흐름도 칸, 범위 막대" },
    "mark-sm": { "$value": "1px", "$description": "산점도 네모 점" }
  },
  "space": {
    "$type": "dimension",
    "panel-gap": { "$value": "14px", "$description": "패널 사이 간격" },
    "panel-inset": { "$value": "16px", "$description": "패널 안쪽 좌우 여백" },
    "panel-top": { "$value": "12px", "$description": "패널 위 여백 (제목 위)" },
    "segment-inset": { "$value": "3px", "$description": "세그먼트(기간, 2초·5초) 안쪽 여백" }
  },
  "font-size": {
    "$type": "dimension",
    "micro": { "$value": "10px", "$description": "오각형 눈금 숫자" },
    "caption": { "$value": "11px", "$description": "캡션, 축 눈금, 배지, 목록 보조 줄" },
    "label": { "$value": "12px", "$description": "라벨, 컨트롤, 범례, 툴팁, 흐름도 칸 이름" },
    "body-sm": { "$value": "13px", "$description": "목록 위험 배수, 준비 조건 수치" },
    "body": { "$value": "14px", "$description": "목록 몬스터 이름, 행 이름" },
    "subtitle": { "$value": "16px", "$description": "패널 안 소제목, 상세 단계·역할" },
    "title": { "$value": "18px", "$description": "패널 제목" },
    "heading": { "$value": "20px", "$description": "머리글, 같은 조건 위험 배수" },
    "kpi": { "$value": "22px", "$description": "KPI 숫자" },
    "display": { "$value": "24px", "$description": "상세 몬스터 이름" }
  },
  "stroke": {
    "width": {
      "$type": "dimension",
      "hairline": { "$value": "0.75px", "$description": "산점도 격자" },
      "thin": { "$value": "1px", "$description": "기준선, 격자, 고리" },
      "ring": { "$value": "1.25px", "$description": "오각형: 축 끝(±3)을 넘은 값의 점선 고리" },
      "regular": { "$value": "1.5px", "$description": "비교선, 평균선, 점선 기준, 초점 고리" },
      "bold": { "$value": "2px", "$description": "고른 몬스터 선, 범례 선" },
      "focus": { "$value": "2px", "$description": "흐름도 칸 키보드 초점 고리" },
      "halo": { "$value": "3px", "$description": "차트 글자 뒤 패널색 테두리 (선 위에서도 읽히게)" }
    },
    "point": {
      "$type": "dimension",
      "$description": "점 반지름",
      "mark": {
        "$value": "6px",
        "$description": "산점도 점 (모든 모양이 이 반지름 원과 같은 넓이)"
      },
      "mark-hover-grow": { "$value": "1.5px", "$description": "산점도 가리킨 점이 커지는 양" },
      "legend": { "$value": "4.5px", "$description": "산점도 범례 점" },
      "vertex": { "$value": "4px", "$description": "오각형 꼭짓점" },
      "vertex-hover": { "$value": "5.5px", "$description": "오각형: 가리킨 축의 꼭짓점" },
      "vertex-ring": { "$value": "8px", "$description": "오각형: 축 끝(±3)을 넘은 값의 점선 고리" },
      "trend": { "$value": "3.5px", "$description": "패치 추이 점" },
      "trend-thin": { "$value": "2.5px", "$description": "패치 추이: 교전이 적은 날 빈 점" },
      "estimate": { "$value": "6px", "$description": "같은 조건 위험 배수 점" }
    }
  },
  "size": {
    "$type": "dimension",
    "bar": {
      "skill": { "$value": "10px", "$description": "보스 기술 막대 높이" },
      "share": { "$value": "25px", "$description": "준비 패널 비율 막대 높이" },
      "interval": { "$value": "4px", "$description": "같은 조건 위험 배수 범위 막대 높이" }
    },
    "dumbbell": {
      "line": { "$value": "2px", "$description": "준비 조건 처치자→사망자 선 두께" },
      "dot": { "$value": "14px", "$description": "준비 조건 점 지름" }
    },
    "legend": {
      "dot": { "$value": "10px", "$description": "범례 동그라미 지름" },
      "swatch-w": { "$value": "16px", "$description": "범례 막대 견본 너비 (높이는 bar.skill)" }
    },
    "sankey": {
      "node-width": { "$value": "14px", "$description": "흐름도 칸 너비" },
      "node-min": { "$value": "18px", "$description": "흐름도 칸 최소 높이 (글자가 겹치지 않게)" },
      "pick-grow": { "$value": "4px", "$description": "고른 칸이 넓어지는 양" }
    }
  },
  "motion": {
    "ease": {
      "board": {
        "$type": "cubicBezier",
        "$value": [0.2, 0.7, 0.2, 1],
        "$description": "보드 전체 한 가지 가속"
      }
    },
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms", "$description": "컨트롤 색, hover" },
      "base": { "$value": "200ms", "$description": "패널 등장, 흐림" },
      "slow": { "$value": "320ms", "$description": "차트 모양 이동, 목록 재정렬" }
    }
  }
}
