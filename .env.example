# Copy to .env.local and fill in with the values you received. .env.local is git-ignored;
# never commit real values or paste them into issues, PRs or chat.

# ClickHouse on EC2 (HTTP interface, usually port 8123 or 8443 for HTTPS)
CLICKHOUSE_URL=http://<ec2-host>:8123
CLICKHOUSE_USER=<user>
CLICKHOUSE_PASSWORD=<password>
CLICKHOUSE_DB=<database>

# Any long random string, shared with whoever runs scripts/db/load_mart.sh.
#   openssl rand -hex 32
REVALIDATE_TOKEN=<random-token>
REVALIDATE_URL=http://localhost:3000/api/revalidate
