# 디자이너용: 아래 한 줄만 .env.local에 넣으면 DB·AWS 없이 녹화된 예시 데이터로 화면이 뜹니다.
#   DATA_SOURCE=fixture
#
# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values or paste
# them into issues, PRs or chat.

# How data functions reach ClickHouse: direct (local dev), lambda (deployments) or fixture
# (recorded results in data/fixtures, no DB; refused on Vercel production).
DATA_SOURCE=direct

# --- DATA_SOURCE=direct: ClickHouse on EC2 (HTTP), read-only account.
# Format must be http[s]://host:port, with no user name in the URL.
CLICKHOUSE_URL=http://<ec2-host>:8123
CLICKHOUSE_USER=api
CLICKHOUSE_PASSWORD=<password>
CLICKHOUSE_DB=default

# --- DATA_SOURCE=lambda: query Lambda (region fixed to ap-northeast-2).
#   Local:  DATA_SOURCE=lambda, QUERY_LAMBDA_NAME=5dots-query, AWS_PROFILE=5dots-dev, AWS_ROLE_ARN empty, pnpm dev
#   Deploy: AWS_ROLE_ARN = the IAM role that trusts Vercel OIDC (also used for S3 below)
QUERY_LAMBDA_NAME=5dots-query
AWS_PROFILE=
AWS_ROLE_ARN=

# --- Precomputed JSON (Python batch): local folder or S3.
PRECOMPUTED_SOURCE=local
# local: folder with <name>.json files. Empty = data/precomputed in this repo
PRECOMPUTED_DIR=
# s3: bucket and key prefix (e.g. precomputed/)
PRECOMPUTED_BUCKET=<bucket>
PRECOMPUTED_PREFIX=

# Any long random string, for POST /api/revalidate.
#   openssl rand -hex 32
REVALIDATE_TOKEN=<random-token>
