# Copy to .env.local and fill in with the values you received. .env.local is git-ignored;
# never commit real values or paste them into issues, PRs or chat.

# ClickHouse on EC2 (HTTP interface). Use the read-only account.
# Format must be http[s]://host:port, with no user name in the URL.
CLICKHOUSE_URL=http://<ec2-host>:8123
CLICKHOUSE_USER=api
CLICKHOUSE_PASSWORD=<password>
CLICKHOUSE_DB=default

# Any long random string, for POST /api/revalidate.
#   openssl rand -hex 32
REVALIDATE_TOKEN=<random-token>
